{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "lib": ["ES2023"],
    "composite": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@lailatul-coder/lailatul-coder-core": ["../core/src/index.ts"],
      "@lailatul-coder/lailatul-coder-core/subSessionConstants": [
        "../core/src/tools/sub-session-constants.ts"
      ],
      "@lailatul-coder/lailatul-coder-core/transcriptRecords": [
        "../core/src/utils/transcript-records.ts"
      ],
      "@lailatul-coder/lailatul-coder-core/*": ["../core/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"],
  "references": [{ "path": "../core" }]
}
